# --- Ollama (local LLM) ---
# Used when running outside Docker. Inside Docker, docker-compose
# overrides this with http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Must match the model pulled by the ollama-init service
MODEL_EXTRACTION=medgemma:4b
MODEL_EXPLANATION=medgemma:4b

# --- Local OCR ---
TESSERACT_LANG=eng+rus

# --- Local Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- App ---
CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_SIZE_MB=10
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8501","http://frontend:8501"]