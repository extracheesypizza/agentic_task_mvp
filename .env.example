# Ollama's OpenAI-compatible API. For native development, Ollama should be
# reachable at this address. Docker Compose overrides this with http://ollama:11434/v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama ignores this value; the OpenAI client requires a non-empty API key.
OLLAMA_API_KEY=ollama

# Docker Compose pulls medgemma:4b automatically. Native Ollama users must pull it once.
MODEL_EXTRACTION=medgemma:4b
MODEL_EXPLANATION=medgemma:4b

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
TESSERACT_LANG=eng+rus
MAX_UPLOAD_SIZE_MB=10
BACKEND_URL=http://localhost:8000
# Pydantic settings expects this value as JSON.
CORS_ORIGINS=["http://localhost:8501","http://frontend:8501"]
